{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "types": ["node"]
  },
  "include": ["apps/*/src/**/*.ts", "apps/*/tests/**/*.ts", "packages/*/src/**/*.ts", "packages/*/tests/**/*.ts", "*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "**/dist"]
}
